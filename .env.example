# FarmIQ Environment Variables
SECRET_KEY=your-super-secret-key-here
FLASK_ENV=production  # or development
DATABASE_URL=sqlite:///farmiq.db  # For Heroku: postgres://...
FARM_IQ_API_KEY=hackathon-api-key-123
CACHE_TYPE=simple  # or redis://host:port
FLASK_DEBUG=False
RATELIMIT_STORAGE_URL=memory://
# Heroku-specific: PORT is auto-set